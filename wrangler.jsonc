{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ravafry",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RSVP_STATE",
        "class_name": "RsvpState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RsvpState"]
    }
  ],
  "vars": {
    "RSVP_API_ENABLED": "false"
  }
}
