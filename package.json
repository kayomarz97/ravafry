{
  "name": "ravafry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "assets": "node scripts/assets.mjs",
    "build": "npm run assets && astro build",
    "build:ci": "node scripts/assets.mjs --published && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "astro check",
    "build:apps-script": "node scripts/build-apps-script.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "astro": "7.3.3",
    "libphonenumber-js": "1.13.13",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260919.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.63.0",
    "@types/google-apps-script": "2.0.13",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "wrangler": "4.135.0"
  }
}
