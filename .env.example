# TURNSTILE_SITE_KEY, RSVP_ALLOWED_ORIGIN, RSVP_TURNSTILE_HOSTNAME, RSVP_API_ENABLED
# Optional development-only in-memory preview: PUBLIC_RSVP_MODE=mock
