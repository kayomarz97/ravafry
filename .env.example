# Copy to ignored .env for CLI setup. Never expose secrets with PUBLIC_ prefixes.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WRANGLER_SEND_METRICS=false
RSVP_SHARED_SECRET=
RSVP_SESSION_SECRET=
RSVP_UPSTREAM_URL=
TURNSTILE_SECRET_KEY=
